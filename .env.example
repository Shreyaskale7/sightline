# --- SEC EDGAR (REQUIRED) ---
# The SEC requires a User-Agent identifying you (name + email). Requests without it get 403'd.
SEC_USER_AGENT="Your Name your@email.com"

# --- Storage / infra ---
QDRANT_URL="http://localhost:6333"
DATA_DIR="./data"

# --- LLM / VLM provider ---
# Any OpenAI-compatible endpoint works (set LLM_BASE_URL), or a raw Anthropic key
# (leave LLM_BASE_URL empty). Set a HARD budget alert on any paid account.
#
# Free option A — Google AI Studio (recommended; generous daily quota, vision):
#   LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   LLM_MODEL="gemini-2.5-flash"   VLM_MODEL="gemini-2.5-flash"
#   ROUTER_MODEL="gemini-2.5-flash-lite"   LLM_MIN_INTERVAL_S="6"
# Free option B — OpenRouter :free models (~50 req/day):
#   LLM_BASE_URL="https://openrouter.ai/api/v1"
#   LLM_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
#   VLM_MODEL="nvidia/nemotron-nano-12b-v2-vl:free"
#   ROUTER_MODEL="nvidia/nemotron-nano-9b-v2:free"
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL="your-chat-model"
VLM_MODEL="your-vision-model"
# Cheap/small model for the router and the eval judge:
ROUTER_MODEL="your-small-model"
# Minimum seconds between LLM requests (free tiers cap requests/minute; 0 = off):
LLM_MIN_INTERVAL_S="0"

# --- Observability (optional; no-ops if left blank) ---
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="http://localhost:3000"

# --- Cost guardrail ---
MONTHLY_BUDGET_USD="10"
